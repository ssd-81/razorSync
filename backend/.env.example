# RazorSync v2 — Copy to .env and fill real values. Never commit .env.
APP_NAME=RazorSync
APP_VERSION=2.0.0
DEBUG=false
DATABASE_URL=sqlite:///./razorSync.db
MERCHANT_ID=merchant_default
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Razorpay Test Mode — from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_dashboard
WEBHOOK_BASE_URL=https://your-tunnel.ngrok-free.app

# Simulation defaults
SIMULATION_DEFAULT_CUSTOMERS=500
SIMULATION_SEEDS=42,137,256
SIMULATION_DURATION_DAYS=7

# Failure simulation (dashboard toggle sets this in-memory; env is default)
SIMULATE_RAZORPAY_FAILURE=false

# Option B - Async ingestion (Redis Stream)
# For local dev without Redis leave empty -> DB fallback (tests use sync path)
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=razor:inbox
REDIS_CONSUMER_GROUP=reasoning

# LLM Free Cloud - Provider-agnostic OpenAI-compatible
# Pick any free tier, change 3 vars. Empty = deterministic fallback.
LLM_PROVIDER=groq
LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_TIMEOUT=5
# Examples:
# Together: LLM_ENDPOINT=https://api.together.xyz/v1/chat/completions LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct-Turbo
# OpenRouter: LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions LLM_MODEL=google/gemini-flash-1.5-8b:free
# HuggingFace: LLM_ENDPOINT=https://api-inference.huggingface.co/v1/chat/completions LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Ollama local: LLM_ENDPOINT=http://localhost:11434/v1/chat/completions LLM_MODEL=llama3.2 LLM_API_KEY=
